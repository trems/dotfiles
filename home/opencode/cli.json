{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight-herdr"
  },
  "plugins": [],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "new_location": "launch",
    "tps": true,
    "image_preview": true,
    "submit_scroll": "keep"
  },
  "animations": true,
  "terminal": {
    "copy": "select",
    "title": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "prompt": {
    "image_preview": true
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal",
    "mode": "off",
    "scope": "cwd"
  }
}
